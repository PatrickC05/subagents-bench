# Copy to .env (gitignored) and fill in. .env never overrides variables already set in your shell.
# Prime Inference API key (app.primeintellect.ai, with the Inference permission): the models of
# configs/prime/models/ (`--model`).
PRIME_API_KEY=
# Optional: bill a Prime team instead of the key owner's account (sent as X-Prime-Team-ID).
PRIME_TEAM_ID=
# Sail Research API key: configs/sail/base.yaml (DeepSeek-V4.1-Flash orchestrator, Gemma-4-31B
# subagents), and the questions and judge of its sweeps, under --model too.
SAIL_API_KEY=
