\n        finally:\n            ctx.resilient_parsing = resilient\n\"\"\"\nnew = \"\"\"        try:\n            default_value = self.get_default(ctx, call=False)\n        finally:\n            ctx.resilient_parsing = resilient\n\n        # A value from the default map takes precedence over the\n        # parameter's own default, so show the value that is actually\n        # used.\n        default_map_value = ctx.lookup_default(self.name)\n\n        if default_map_value is not None:\n            default_"}}
