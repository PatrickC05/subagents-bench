ption(\"--p\", type=click.Path(resolve_path=True))\ndef pcli(p):\n    click.echo(p)\nprint(\"2.2\", r.invoke(pcli, [\"--p\", f\"{d}/link\"]).output.strip(), \"expected\", f\"{d}/real.txt\")\n\n# 2.3\n@click.command()\n@click.option(\"--name/--no-name\", is_flag=True, show_default=True)\ndef foo(name):\n    click.echo(name)\nprint(\"2.3\", [l for l in r.invoke(foo, [\"--help\"], obj=None).output.splitlines() if \"default\" in l])\nctx = click.Context(foo, default_map={\"foo\": {\"name\": True}})\nprint(\"2.3b\", foo.get_params(ctx)[0].get_help_record(ctx)[1])\nE"}}
