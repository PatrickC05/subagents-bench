 dayjs('2014-06-01T12:00:00Z').tz('Europe/London').format('Z'), moment('2014-06-01T12:00:00Z').tz('Europe/London').format('Z'))\n  show('convert 12:00Z->Kolkata Z', dayjs('2014-06-01T12:00:00Z').tz('Asia/Kolkata').format('Z'), moment('2014-06-01T12:00:00Z').tz('Asia/Kolkata').format('Z'))\n  show('convert winter 12:00Z->NY Z', dayjs('2014-12-01T12:00:00Z').tz(NY).format('Z'), moment('2014-12-01T12:00:00Z').tz(NY).format('Z'))\n\n  show('parse 2014-06-01 12:00 NY', dayjs.tz('2014-06-01 12:00', NY).format(), moment.tz('2014-06-01 12:00', NY).format())\n  show('parse Z', dayjs.tz('2014-06-01 12:00', NY).format('Z'), moment.tz('2014-06-01 12:00', NY).format('Z'))\n\n  const ts = 1401638400000\n  show('tz(number) ', dayjs.tz(ts, NY).format(), moment.tz(ts, NY).format())\n  show('tz(Date)   ', dayjs.tz(new Date(ts), NY).format(), moment.tz(new Date(ts), NY).format())\n  show('tz(Dayjs)  ', dayjs.tz(dayjs(ts), NY).format(), moment.tz(moment(ts), NY).format())\n  show('tz(Dayjs w/offset)', dayjs.tz(dayjs('2014-06-01T12:00:00Z').tz(NY), NY).format(), moment.tz(moment('2014-06-01T12:00:00Z').tz(NY), NY).format())\n  show('tz(number) Z', dayjs.tz(ts, NY).format('Z'), moment.tz(ts, NY).format('Z'))\n  show('tz(number) valueOf', dayjs.tz(ts, NY).valueOf(), moment.tz(ts, NY).valueOf())\n  show('tz(string) valueOf', dayjs.tz('2014-06-01 12:00', NY).valueOf(), moment.tz('2014-06-01 12:00', NY).valueOf())\n  show('tz(string) utcOffset', dayjs.tz('2014-06-01 12:00', NY).utcOffset(), moment.tz('2014-06-01 12:00', NY).utcOffset())\n  show('tz(number) utcOffset', dayjs.tz(ts, NY).utcOffset(), moment.tz(ts, NY).utcOffset())\n\n  // DST spring forward / fall back\n  const s1 = '2012-03-11 02:00:00'\n  show('DST spring', dayjs.tz(s1, NY).format(), moment.tz(s1, NY).format())\n  const s2 = '2012-11-04 01:00:00'\n  show('DST fall', dayjs.tz(s2, NY).format(), moment.tz(s2, NY).format())\n\n  // tz to tz\n  show('NY->LA', dayjs.tz('2014-06-01 12:00', NY).tz('America/Los_Angeles').format(), moment.tz('2014-06-01 12:00', NY).tz('America/Los_Angeles').format())\n  show('NY->London', dayjs.tz('2014-06-01 12:00', NY).tz('Europe/London').format(), moment.tz('2014-06-01 12:00', NY).tz('Europe/London').format())\n  show('utc->NY', dayjs.utc('2", "parent_agent_id": null, "status": "submitted", "steps_used": 11, "t_start": 1792140568.612718, "t_end": 1792140708.327093, "report_chars": 25626, "files_modified": [], "error": null, "t_stop_requested": null}
